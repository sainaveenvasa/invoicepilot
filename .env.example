# InvoicePilot environment variables.
#
# Copy to `.env` for local development:  cp .env.example .env
# `.env` is git-ignored. Never commit real values. Staging and production get
# every value from the platform's secret store, not from a file.
#
# Legend:  [prod: required]   production settings refuse to start without it
#          [prod: optional]   has a safe production default
#          [local]            only meaningful for local development / Compose

# --- Django ---------------------------------------------------------------

# Which settings module to load: config.settings.local | test | production.
# manage.py defaults to local, wsgi/asgi to production, pytest to test.
DJANGO_SETTINGS_MODULE=config.settings.local

# [prod: required] Signs sessions, CSRF, password-reset and verification tokens.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(50))"
# Local settings fall back to an insecure fixed key when this is empty.
DJANGO_SECRET_KEY=

# [local] Debug pages. Local defaults to 1; production ignores this and is always off.
DJANGO_DEBUG=1

# [prod: required] Comma-separated host names this app serves. Exact names only.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# [prod: required] Comma-separated origins (scheme + host) trusted for CSRF.
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000

# [prod: required] Absolute base URL used for links in emails. Never derived
# from the request's Host header.
SITE_URL=http://localhost:8000

# [prod: optional] Number of proxies in front of the app that append to
# X-Forwarded-For (1 behind a single load balancer). Used for login throttling.
DJANGO_NUM_TRUSTED_PROXIES=0

# [prod: optional] HTTPS hardening. Defaults: redirect on, HSTS one year,
# subdomains/preload off until HTTPS is stable everywhere.
# DJANGO_SECURE_SSL_REDIRECT=1
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=0
# DJANGO_SECURE_HSTS_PRELOAD=0
# Set to 1 only behind a proxy that always overwrites X-Forwarded-Proto.
# DJANGO_SECURE_PROXY_SSL_HEADER=0

# [prod: optional] Root log level.
DJANGO_LOG_LEVEL=INFO

# --- PostgreSQL 17 (SQLite is not supported) ------------------------------

POSTGRES_DB=invoicepilot
POSTGRES_USER=invoicepilot
# [local] Password for the Compose database container. Pick anything; it only
# protects your local container. Production uses its own secret.
POSTGRES_PASSWORD=invoicepilot-local
# Compose overrides HOST to `db`. Use localhost when running Django on your machine.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# [local] Host port Compose publishes the database on (change if 5432 is taken).
POSTGRES_HOST_PORT=5432
# Seconds to keep connections open between requests.
POSTGRES_CONN_MAX_AGE=60

# --- Email ----------------------------------------------------------------

# Local default prints emails to the console; Compose sends them to Mailpit
# (http://localhost:8025). Production uses SMTP with the provider's credentials.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=1
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=InvoicePilot <no-reply@localhost>
